{
  "name": "pierry.projects.adm",
  "version": "2.0.0",
  "description": "Frutiger Aero Admin Dashboard com Firebase Firestore",
  "scripts": {
    "build:sass": "sass src/styles/styles.scss src/styles/styles.css --no-source-map",
    "build:ts": "tsc",
    "build": "npm run build:sass && npm run build:ts",
    "watch": "concurrently \"sass --watch src/styles/styles.scss:src/styles/styles.css\" \"tsc --watch\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "firebase": "^10.12.0",
    "sass": "^1.72.0",
    "typescript": "^5.4.2"
  }
}